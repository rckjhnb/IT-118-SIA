<%- include('partials/header') %>

<div class="auth-wrap single">
  <div class="auth-card">
    <h1>Log in</h1>
    <p class="lede">Use your BU email and password.</p>

    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <form method="post" action="/login" class="form">
      <input type="hidden" name="next" value="<%= next %>">
      <label>BU email
        <input type="email" name="email" value="<%= values.email || '' %>" required autofocus>
      </label>
      <label>Password
        <input type="password" name="password" required>
      </label>
      <button class="btn" type="submit">Log in</button>
    </form>

    <p class="small">
      <a href="/forgot">Forgot password?</a> ·
      New here? <a href="/signup">Create an account</a>
    </p>

    <div class="demo-box">
      <strong>Demo accounts</strong>
      <p><code>maria.santos24@bicol-u.edu.ph</code> · <code>Password123</code></p>
      <p><code>admin@bicol-u.edu.ph</code> · <code>Password123</code></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
