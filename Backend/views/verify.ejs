<%- include('partials/header') %>

<div class="auth-wrap single">
  <div class="auth-card">
    <h1>Check your BU email</h1>
    <p class="lede">We sent a 6-digit code to <strong><%= email %></strong>. It expires in 15 minutes.</p>

    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <form method="post" action="/verify" class="form">
      <input type="hidden" name="email" value="<%= email %>">
      <label>Verification code
        <input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" autofocus required>
      </label>
      <button class="btn" type="submit">Verify email</button>
    </form>

    <form method="post" action="/verify/resend" class="inline-form">
      <input type="hidden" name="email" value="<%= email %>">
      <button class="link-btn" type="submit">Send a new code</button>
    </form>

    <p class="small">No email arrived? For this prototype, read it at <a href="/dev/outbox">Dev outbox</a>.</p>
  </div>
</div>

<%- include('partials/footer') %>
