{
  "name": "foundit-lost-and-found",
  "version": "1.0.0",
  "description": "FoundIT: campus lost and found for Bicol University",
  "main": "Backend/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "node --watch Backend/server.js",
    "check": "node Backend/check.cjs",
    "seed:mongo": "node Backend/seed-mongo.js",
    "web:dev": "npm --prefix Web run dev",
    "web:build": "npm --prefix Web run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "mongodb": "^6.22.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.3.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  }
}
