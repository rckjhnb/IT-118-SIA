# Optional. Copy to .env — `npm start` loads it automatically.

# Port the app listens on
PORT=3000

# Change this before showing the app to anyone
SESSION_SECRET=replace-with-a-long-random-string

# Leave these empty to keep verification codes in the Dev outbox.
# To send real email through Gmail, enable 2-Step Verification and create an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-character-app-password
