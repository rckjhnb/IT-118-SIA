PORT=3000
NODE_ENV=development
# Required in production. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Password for the seeded admin account (admin@bicol-u.edu.ph). Set this before real use.
ADMIN_PASSWORD=
# Set to 1 when running behind a reverse proxy (Render, Nginx, etc.)
TRUST_PROXY=
# Optional. With no SMTP_HOST, codes are only stored in the dev outbox (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
